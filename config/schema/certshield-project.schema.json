{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practice.certshield.co.in/config/schema/certshield-project.schema.json",
  "title": "CertShield Practice project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskMode", "inputDiscovery", "site", "seo", "actions"],
  "properties": {
    "taskMode": {
      "enum": ["FRAMEWORK_BUILD", "UPSERT_ASSESSMENT", "MONTHLY_OFFERS_UPDATE", "NEW_COURSE_SYNC"]
    },
    "inputDiscovery": { "enum": ["AUTO", "MANUAL"] },
    "inputOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "couponSheet": { "type": ["string", "null"] },
        "referralSheet": { "type": ["string", "null"] },
        "assessmentSearchRoots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "practiceUrl", "mainUrl", "customDomain", "udemyInstructor"],
      "properties": {
        "brand": { "type": "string" },
        "practiceUrl": { "type": "string", "format": "uri" },
        "mainUrl": { "type": "string", "format": "uri" },
        "customDomain": { "type": "string" },
        "udemyInstructor": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessmentsEnabled": { "type": "boolean" },
        "offersEnabled": { "type": "boolean" },
        "sampleDataStatus": { "enum": ["sample", "production"] }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalOrigin", "defaultLanguage", "globalAudience", "indexNowEnabled"],
      "properties": {
        "canonicalOrigin": { "type": "string", "format": "uri" },
        "defaultLanguage": { "type": "string" },
        "globalAudience": { "type": "boolean" },
        "indexNowEnabled": { "type": "boolean" },
        "indexNowKey": { "type": ["string", "null"] },
        "searchConsoleVerification": { "type": ["string", "null"] },
        "bingVerification": { "type": ["string", "null"] }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy", "push", "createPr"],
      "properties": {
        "deploy": { "type": "boolean" },
        "push": { "type": "boolean" },
        "createPr": { "type": "boolean" }
      }
    }
  }
}
